{
  "name": "write",
  "title": "Change a graph",
  "description": "Add or change tasks and dependencies; merges, never deletes.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "graph": {
        "$ref": "common.json#/graph_id"
      },
      "new_graph": {
        "type": "boolean",
        "description": "Start a separate graph instead of merging."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Names the graph."
      },
      "tasks": {
        "type": "array",
        "maxItems": 200,
        "description": "Tasks to create or update, matched by key.",
        "items": {
          "$ref": "common.json#/task"
        }
      },
      "edges": {
        "$ref": "common.json#/edges",
        "description": "Dependencies to add."
      },
      "unlink": {
        "$ref": "common.json#/edges",
        "description": "Dependencies to remove; the tasks stay."
      }
    }
  }
}
