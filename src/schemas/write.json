{
  "name": "write",
  "title": "Change a graph",
  "description": "Add or change tasks and what they wait for; merges, never deletes.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "graph": {
        "$ref": "common.json#/graph_id"
      },
      "new_graph": {
        "type": "boolean",
        "description": "Start a separate graph instead of merging."
      },
      "title": {
        "$ref": "common.json#/graph/properties/title"
      },
      "tasks": {
        "$ref": "common.json#/graph/properties/tasks",
        "description": "Tasks to create or update, matched by key."
      }
    }
  }
}
