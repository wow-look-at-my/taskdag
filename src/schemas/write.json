{
  "name": "write",
  "title": "Change a graph",
  "description": "Add or change tasks and dependencies; merges, never deletes.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "graph": {
        "$ref": "common.json#/graph_id"
      },
      "new_graph": {
        "type": "boolean",
        "description": "Start a separate graph instead of merging."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Names the graph."
      },
      "tasks": {
        "type": "array",
        "maxItems": 200,
        "description": "Tasks to create or update, matched by key.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "$ref": "common.json#/task_key"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Short imperative title; required for a new task."
            },
            "detail": {
              "$ref": "common.json#/detail"
            },
            "status": {
              "$ref": "common.json#/status",
              "description": "Omitted leaves an existing status alone."
            },
            "priority": {
              "$ref": "common.json#/priority"
            },
            "tags": {
              "$ref": "common.json#/tags"
            }
          }
        }
      },
      "edges": {
        "$ref": "common.json#/edges",
        "description": "Dependencies to add."
      },
      "unlink": {
        "$ref": "common.json#/edges",
        "description": "Dependencies to remove; the tasks stay."
      }
    }
  }
}
