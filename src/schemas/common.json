{
  "graph_id": {
    "type": "string",
    "pattern": "^g_[0-9a-f]{16}$",
    "description": "Graph handle; omit for the most recent."
  },
  "task_key": {
    "type": "string",
    "minLength": 2,
    "maxLength": 64,
    "description": "A slug from the title, like \"write-tests\"; \"T3\" is refused."
  },
  "status": {
    "type": "string",
    "enum": [
      "todo",
      "in_progress",
      "done",
      "blocked",
      "cancelled"
    ]
  },
  "tags": {
    "description": "Labels; an array replaces them, {add,remove} edits them.",
    "oneOf": [
      {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 40
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "description": "Edits the list in place instead of replacing it.",
        "properties": {
          "add": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "remove": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          }
        }
      }
    ]
  },
  "priority": {
    "type": "integer",
    "description": "Higher sorts first in the ready queue."
  },
  "detail": {
    "type": "string",
    "description": "Long-form context, returned by read(what=task) but never in a receipt."
  },
  "task": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "key"
    ],
    "description": "One task; only `key` is required, and `title` only when the key is new.",
    "properties": {
      "key": {
        "$ref": "common.json#/task_key"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Short imperative title."
      },
      "parents": {
        "description": "Keys this task waits for; an array replaces them, {add,remove} edits them.",
        "oneOf": [
          {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "description": "Edits the list in place instead of replacing it.",
            "properties": {
              "add": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string"
                }
              },
              "remove": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "detail": {
        "$ref": "common.json#/detail"
      },
      "status": {
        "$ref": "common.json#/status"
      },
      "priority": {
        "$ref": "common.json#/priority"
      },
      "tags": {
        "$ref": "common.json#/tags"
      }
    }
  },
  "graph": {
    "type": "object",
    "additionalProperties": false,
    "description": "A graph: a title and its tasks, each naming what it waits for.",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Names the graph."
      },
      "tasks": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "$ref": "common.json#/task"
        }
      }
    }
  }
}
