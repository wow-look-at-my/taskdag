{
  "graph_id": {
    "type": "string",
    "pattern": "^g_[0-9a-f]{16}$",
    "description": "Graph handle; omit for the most recent."
  },
  "task_key": {
    "type": "string",
    "minLength": 2,
    "maxLength": 64,
    "description": "A slug from the title, like \"write-tests\"; \"T3\" is refused."
  },
  "status": {
    "type": "string",
    "enum": [
      "todo",
      "in_progress",
      "done",
      "blocked",
      "cancelled"
    ]
  },
  "tags": {
    "type": "array",
    "items": {
      "type": "string",
      "maxLength": 40
    },
    "maxItems": 20
  },
  "priority": {
    "type": "integer",
    "description": "Higher sorts first in the ready queue."
  },
  "edges": {
    "type": "array",
    "maxItems": 400,
    "description": "{ from, to } means \"from depends on to\"; cycles and self-edges are refused.",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "The dependent key."
        },
        "to": {
          "type": "string",
          "description": "The prerequisite key."
        }
      }
    }
  },
  "detail": {
    "type": "string",
    "description": "Long-form context, returned by read(what=task) but never in a receipt."
  }
}
